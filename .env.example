# Copy this file to .env.local and fill in your own values. .env.local is git-ignored.

# PostgreSQL connection: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:your_password@localhost:5432/crewguard

# Secret used to sign login sessions. Any long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string
